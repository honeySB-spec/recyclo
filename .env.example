# ========================================================
# RECYCLO ENVIRONMENT CONFIGURATION
# ========================================================

# SERVER PORT & HOST
PORT=5000
NODE_ENV=production

# SUPABASE (PostgreSQL & Storage)
# Found under Project Settings -> API in Supabase dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# GOOGLE GEMINI MULTIMODAL API
# For Vision Scanner, Speech-To-Text & Agent Reasoning
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ELEVENLABS API
# For Hyper-realistic Text-to-Speech
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# YOUTUBE DATA API v3
# For fetching upcycling & restoration tutorials
YOUTUBE_API_KEY=your-youtube-data-api-key

# NEXT.JS FRONTEND ENVIRONMENT (client/.env.local)
NEXT_PUBLIC_API_URL=https://recyclo-api.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
